<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Exclude test classes -->
    <Match>
        <Class name="~.*Test.*"/>
    </Match>
    
    <!-- Exclude generated code -->
    <Match>
        <Class name="~.*\.generated\..*"/>
    </Match>
    
    <!-- Allow System.out.println in main methods -->
    <Match>
        <Method name="main"/>
        <Bug pattern="DM_EXIT"/>
    </Match>
</FindBugsFilter>
