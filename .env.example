# Preferir secrets.env (copiar secrets.env.example → secrets.env).
# Este archivo es legacy para scripts que aún lean .env.

TENANT_ID=your_tenant_id_here
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here
MAIL_CORREO=your_email@domain.com
PATH_DESTINATION=/data/attachments
PROCESSED_FOLDER=deleteditems
PRIVATE_CERTIFICATE=artifact/jar/certs/account/mailbox.domain.com-full.pem
CERTIFICATE_PASSWORD=your_certificate_password
PROXY_HOST=your_proxy_host
PROXY_PORT=3128
SCOPE=https://graph.microsoft.com/.default
GRANT_TYPE=client_credentials
