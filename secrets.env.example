# Copiar a secrets.env (no se versiona). Valores reales solo en secrets.env.
#   cp secrets.env.example secrets.env

# Azure AD — aplicación Graph (client credentials)
TENANT_ID=your-tenant-id
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret

# Buzón y rutas
MAIL_CORREO=mailbox@domain.com
PATH_DESTINATION=/data/attachments
PROCESSED_FOLDER=deleteditems

# Certificado (alternativa a CLIENT_SECRET; producción GFS)
# Carpeta canónica: artifact/jar/certs/  (GFS: /gfssterling/jar/certs/)
# Ver artifact/jar/certs/README.md
PRIVATE_CERTIFICATE=artifact/jar/certs/account/mailbox.domain.com-full.pem
CERTIFICATE_PASSWORD=your_certificate_password
# O365_CERTS_ROOT=artifact/jar/certs
# O365_CERTS_ACCOUNT=artifact/jar/certs/account
CLIENT_ID_CIPHER=

# Proxy corporativo (puerto 3128 en todos los perfiles)
PROXY_PORT=3128
# Nombre en GFS / DNS interno (app.5.4.0.sh tras Cipher)
PROXY_HOST=latam-proxy-SLV.glb.lnm.bns
# Sterling lab Hyper-V (mismo proxy, IP)
PROXY_HOST_LAB=192.168.137.3
# Cursor / WSL2 hacia red lab
PROXY_HOST_WSL=172.21.224.1
# Forzar perfil: lab | wsl | default (vacío = auto WSL → PROXY_HOST_WSL)
# O365_PROXY_PROFILE=wsl

# Postman / OAuth helper
SCOPE=https://graph.microsoft.com/.default
GRANT_TYPE=client_credentials

# Lab Colpatria (referencia; ajustar por ambiente)
# PATH_GFS=/gfssterling
# JAR_PATH=/gfssterling/jar/5.0.0
# PRIVATE_CERTIFICATE=/gfssterling/jar/certs/account/mailbox.domain.com-full.pem
